# Copy to bot/.env and fill in. Never commit the real file.
MODE=paper              # paper = simulated $50, no orders.  live = real orders.
BINANCE_KEY=
BINANCE_SECRET=
RISK_PCT=0.5            # % of the account risked per trade
LEVERAGE=3              # per-symbol leverage and total exposure cap
HALT_BELOW=30           # stop opening new trades if the balance falls below this many USDT
# BASE_URL=https://demo-fapi.binance.com   # Binance futures testnet
